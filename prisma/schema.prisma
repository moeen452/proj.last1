generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                      Int       @id @default(autoincrement())
  email                   String    @unique
  passwordHash            String
  fullName                String
  role                    String    @default("owner")
  isEmailVerified         Boolean   @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  passwordResetToken      String?
  passwordResetExpiry     DateTime?
  passwordResetCode       String?
  preferredLanguage       String    @default("ar")
  privacySettings         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  startup          Startup?
  subscriptions    UserSubscription[]
  notifications    Notification[]
  followedStartups Follow[]
  favorites        Favorite[]
  investments      Investment[]
  consultationSlots ConsultationSlot[]
  consultationBookings ConsultationBooking[]
  eventRegistrations EventRegistration[]
  jobApplications  JobApplication[]
  trainingRegistrations TrainingRegistration[]
  refreshTokens    RefreshToken[]
  newsLikes        NewsLike[]

  @@map("users")
}

model Startup {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  name              String
  slug              String    @unique
  category          String?
  description       String?
  story             String?
  team              String?
  isSuccessStory    Boolean   @default(false)
  successHighlights String?
  approvalStatus    String    @default("pending")
  approvedAt        DateTime?
  rating            Float     @default(0)
  reviewsCount      Int       @default(0)
  email             String?
  phone             String?
  address           String?
  websiteUrl        String?
  coverUrl          String?
  logoUrl           String?
  foundedYear       String?
  location          String?
  vision            String?
  mission           String?
  featuredImage     String?
  stage             String?
  technologies      String?
  services          String?
  officeHours       String?
  photos            String?
  isFeatured        Boolean   @default(false)
  whatsappNumber    String?
  followersCount    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ═══════════════════════════════════════
  // 🔥 الحقول الجديدة 🔥
  // ═══════════════════════════════════════
  customerSatisfaction Int?
  totalClients        Int?
  servicesCount       Int?
  requiredInvestment  Float?
  features            String?  // JSON array of feature strings
  // ═══════════════════════════════════════

  user          User                     @relation(fields: [userId], references: [id])
  brands        Brand[]
  website       Website?
  brandRequests BrandGenerationRequest[]
  inquiries     ContactInquiry[]
  contacts      Contact[]
  followers     Follow[]
  favorites     Favorite[]
  fundingRounds FundingRound[]
  investments    Investment[]
  notifications Notification[]
  news          NewsArticle[]

  @@map("startups")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  displayName String
  slug        String    @unique

  @@map("categories")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  startupId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  startup Startup @relation(fields: [startupId], references: [id])

  @@unique([userId, startupId])
  @@map("favorites")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String?
  type        String?
  location    String?
  date        DateTime?
  time        String?
  price       String?
  isOnline    Boolean  @default(false)
  status      String?
  tags        String?
  imageUrl    String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  registrations EventRegistration[]

  @@map("events")
}

model Contact {
  id        Int      @id @default(autoincrement())
  startupId Int
  name      String
  title     String?
  email     String?
  phone     String?
  imageUrl  String?
  createdAt DateTime @default(now())

  startup Startup @relation(fields: [startupId], references: [id])

  @@map("contacts")
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@map("support_messages")
}

model FundingRound {
  id          Int      @id @default(autoincrement())
  startupId   Int
  roundType   String
  amount      String
  roundDate   DateTime?
  createdAt   DateTime @default(now())

  // ═══════════════════════════════════════
  // 🔥 الحقول الجديدة 🔥
  // ═══════════════════════════════════════
  availableEquityPercentage Float?
  currentValuation         Float?
  // ═══════════════════════════════════════

  startup Startup @relation(fields: [startupId], references: [id])

  @@map("funding_rounds")
}

model Follow {
  id        Int      @id @default(autoincrement())
  userId    Int
  startupId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  startup Startup @relation(fields: [startupId], references: [id])

  @@unique([userId, startupId])
  @@map("follows")
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  startupId Int
  name      String
  email     String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  startup Startup @relation(fields: [startupId], references: [id])

  @@map("contact_inquiries")
}

model Brand {
  id        Int      @id @default(autoincrement())
  startupId Int
  assets    String
  createdAt DateTime @default(now())

  startup Startup @relation(fields: [startupId], references: [id])

  @@map("brands")
}

model BrandGenerationRequest {
  id          Int       @id @default(autoincrement())
  startupId   Int
  description String
  status      String    @default("pending")
  result      String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  startup Startup @relation(fields: [startupId], references: [id])

  @@map("brand_generation_requests")
}

model Website {
  id           Int              @id @default(autoincrement())
  startupId    Int              @unique
  isPublished  Boolean          @default(false)
  publishedUrl String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  startup  Startup          @relation(fields: [startupId], references: [id])
  sections WebsiteSection[]

  @@map("websites")
}

model WebsiteSection {
  id          Int      @id @default(autoincrement())
  websiteId   Int
  sectionType String
  isVisible   Boolean  @default(true)
  orderIndex  Int
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id])

  @@map("website_sections")
}

model Plan {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  price        Decimal
  durationDays Int
  limits       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions UserSubscription[]

  @@map("plans")
}

model UserSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  planId    Int
  status    String
  startedAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@map("user_subscriptions")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  startupId Int?
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  startup Startup? @relation(fields: [startupId], references: [id])

  @@map("notifications")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  userAgent String?
  ipAddress String?
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model NewsArticle {
  id          Int      @id @default(autoincrement())
  startupId   Int
  title       String
  summary     String?
  content     String
  author      String
  imageUrl    String?
  category    String?
  sourceCompany String?
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  tags        String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  startup   Startup     @relation(fields: [startupId], references: [id])
  userLikes NewsLike[]

  @@map("news_articles")
}

model NewsLike {
  id        Int      @id @default(autoincrement())
  newsId    Int
  userId    Int
  createdAt DateTime @default(now())

  news NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@map("news_likes")
}

model Investment {
  id         Int      @id @default(autoincrement())
  userId     Int
  startupId  Int
  amount     String
  shares     Float?
  note       String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  startup Startup @relation(fields: [startupId], references: [id])

  @@map("investments")
}

model ConsultationSlot {
  id           Int      @id @default(autoincrement())
  consultantId Int
  startTime    DateTime
  endTime      DateTime
  isBooked     Boolean  @default(false)
  createdAt    DateTime @default(now())

  consultant User @relation(fields: [consultantId], references: [id])
  bookings ConsultationBooking[]

  @@map("consultation_slots")
}

model ConsultationBooking {
  id        Int      @id @default(autoincrement())
  slotId    Int
  userId    Int
  status    String   @default("booked")
  createdAt DateTime @default(now())

  slot ConsultationSlot @relation(fields: [slotId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("consultation_bookings")
}

model EventRegistration {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  status    String   @default("registered")
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  company     String?
  location    String?
  salary      String?
  type        String?   @default("full-time")
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications JobApplication[]

  @@map("jobs")
}

model Training {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  instructor  String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int?
  price       String?
  status      String    @default("upcoming")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registrations TrainingRegistration[]

  @@map("trainings")
}

model JobApplication {
  id         Int      @id @default(autoincrement())
  jobId      Int
  userId     Int
  resumeUrl  String?
  coverLetter String?
  status     String   @default("applied")
  createdAt  DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("job_applications")
}

model TrainingRegistration {
  id         Int      @id @default(autoincrement())
  trainingId Int
  userId     Int
  status     String   @default("registered")
  createdAt  DateTime @default(now())

  training Training @relation(fields: [trainingId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([trainingId, userId])
  @@map("training_registrations")
}