{
  "info": {
    "_postman_id": "b1f5c9a2-collection-0001",
    "name": "StartupManagement API - Full Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Comprehensive Postman collection for testing all API flows: auth, startups, news, hub, user actions, notifications, support, and funding.\nReplace {{baseUrl}} with e.g. http://localhost:3000/api/v1 and set {{authToken}} after login."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "authToken", "value": "" },
    { "key": "startupId", "value": "1" },
    { "key": "newsId", "value": "1" },
    { "key": "eventId", "value": "1" },
    { "key": "jobId", "value": "1" },
    { "key": "trainingId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"tester@example.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Test User\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth","signup"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"tester@example.com\",\n  \"password\": \"Password123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/auth/refreshToken", "host": ["{{baseUrl}}"], "path": ["auth","refreshToken"] }, "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Startups",
      "item": [
        { "name": "List Startups", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/startups?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["audience","startups"], "query": [{"key":"page","value":"1"},{"key":"limit","value":"10"}] } } },
        { "name": "Featured Startups", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/startups/featured", "host": ["{{baseUrl}}"], "path": ["audience","startups","featured"] } } },
        { "name": "Latest Startups", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/startups/latest", "host": ["{{baseUrl}}"], "path": ["audience","startups","latest"] } } },
        { "name": "Startup Details (by slug)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/startups/my-startup-slug", "host": ["{{baseUrl}}"], "path": ["audience","startups","my-startup-slug"] }, "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }] } },
        { "name": "Startup Details (by id)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/startups/id/{{startupId}}", "host": ["{{baseUrl}}"], "path": ["audience","startups","id","{{startupId}}"] }, "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }] } },
        { "name": "Startup Contacts", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/startups/{{startupId}}/contacts", "host": ["{{baseUrl}}"], "path": ["audience","startups","{{startupId}}","contacts"] } } },
        { "name": "Search Startups", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/startups/search?search=tech&page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["audience","startups","search"], "query": [{"key":"search","value":"tech"},{"key":"page","value":"1"},{"key":"limit","value":"10"}] } } },
        { "name": "Categories", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/categories", "host": ["{{baseUrl}}"], "path": ["audience","categories"] } } }
      ]
    },
    {
      "name": "News",
      "item": [
        { "name": "List News", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/news?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["audience","news"], "query":[{"key":"page","value":"1"},{"key":"limit","value":"10"}] } } },
        { "name": "News Details", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/news/{{newsId}}", "host": ["{{baseUrl}}"], "path": ["audience","news","{{newsId}}"] }, "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }] } },
        { "name": "Like News (toggle)", "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/audience/news/{{newsId}}/like", "host": ["{{baseUrl}}"], "path": ["audience","news","{{newsId}}","like"] }, "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }] } },
        { "name": "Comment on News (increment count)", "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/audience/news/{{newsId}}/comment", "host": ["{{baseUrl}}"], "path": ["audience","news","{{newsId}}","comment"] }, "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }] } },
        { "name": "Share News (increment count)", "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/audience/news/{{newsId}}/share", "host": ["{{baseUrl}}"], "path": ["audience","news","{{newsId}}","share"] }, "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }] } }
      ]
    },
    {
      "name": "Hub (Events / Jobs / Trainings)",
      "item": [
        { "name": "Events List", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/hub/events?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["audience","hub","events"], "query":[{"key":"page","value":"1"},{"key":"limit","value":"10"}] } } },
        { "name": "Register For Event", "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/audience/hub/events/{{eventId}}/register", "host": ["{{baseUrl}}"], "path": ["audience","hub","events","{{eventId}}","register"] }, "header":[{"key":"Authorization","value":"Bearer {{authToken}}"}] } },
        { "name": "Jobs List", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/hub/jobs?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["audience","hub","jobs"], "query":[{"key":"page","value":"1"},{"key":"limit","value":"10"}] } } },
        { "name": "Apply For Job", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{authToken}}"}], "body": { "mode":"raw", "raw": "{\n  \"resumeUrl\": \"https://example.com/resume.pdf\",\n  \"coverLetter\": \"I am interested in this position.\"\n}" }, "url": { "raw": "{{baseUrl}}/audience/hub/jobs/{{jobId}}/apply", "host": ["{{baseUrl}}"], "path": ["audience","hub","jobs","{{jobId}}","apply"] } } },
        { "name": "Trainings List", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/hub/trainings?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["audience","hub","trainings"], "query":[{"key":"page","value":"1"},{"key":"limit","value":"10"}] } } },
        { "name": "Register For Training", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{authToken}}"}], "url": { "raw": "{{baseUrl}}/audience/hub/trainings/{{trainingId}}/register", "host": ["{{baseUrl}}"], "path": ["audience","hub","trainings","{{trainingId}}","register"] } }
      ]
    },
    {
      "name": "User Actions",
      "item": [
        { "name": "Follow Startup", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/startups/{{startupId}}/follow", "host": ["{{baseUrl}}"], "path": ["audience","startups","{{startupId}}","follow"] } } },
        { "name": "Add Favorite", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/favorites", "host": ["{{baseUrl}}"], "path": ["audience","favorites"] }, "body": { "mode": "raw", "raw": "{ \"startupId\": {{startupId}} }" } } },
        { "name": "Remove Favorite", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/favorites/{{startupId}}", "host": ["{{baseUrl}}"], "path": ["audience","favorites","{{startupId}}"] } } },
        { "name": "Invest In Startup", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{authToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"amount\": \"5000\",\n  \"shares\": 2.5,\n  \"note\": \"Seed investment\"\n}" }, "url": { "raw": "{{baseUrl}}/audience/startups/{{startupId}}/invest", "host": ["{{baseUrl}}"], "path": ["audience","startups","{{startupId}}","invest"] } } },
        { "name": "Get Available Equity", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/startups/{{startupId}}/equity", "host": ["{{baseUrl}}"], "path": ["audience","startups","{{startupId}}","equity"] } } },
        { "name": "Get Stock Price Growth", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/startups/{{startupId}}/stock-growth", "host": ["{{baseUrl}}"], "path": ["audience","startups","{{startupId}}","stock-growth"] } } }
      ]
    },
    {
      "name": "Consultations & Profile",
      "item": [
        { "name": "Available Slots", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/consultations/slots", "host": ["{{baseUrl}}"], "path": ["audience","consultations","slots"] } } },
        { "name": "Book Consultation", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{authToken}}" }], "body": { "mode": "raw", "raw": "{ \"slotId\": 1 }" }, "url": { "raw": "{{baseUrl}}/audience/consultations/book", "host": ["{{baseUrl}}"], "path": ["audience","consultations","book"] } } },
        { "name": "Upcoming Bookings", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/consultations/upcoming", "host": ["{{baseUrl}}"], "path": ["audience","consultations","upcoming"] } } },
        { "name": "Get Profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/profile", "host": ["{{baseUrl}}"], "path": ["audience","profile"] } } },
        { "name": "Update Profile", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{authToken}}" }], "body": { "mode": "raw", "raw": "{ \"fullName\": \"Updated Name\" }" }, "url": { "raw": "{{baseUrl}}/audience/profile", "host": ["{{baseUrl}}"], "path": ["audience","profile"] } } }
      ]
    },
    {
      "name": "Favorites / Following / Notifications",
      "item": [
        { "name": "Get Favorites", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/favorites", "host": ["{{baseUrl}}"], "path": ["audience","favorites"] } } },
        { "name": "Get Following", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/following", "host": ["{{baseUrl}}"], "path": ["audience","following"] } } },
        { "name": "Get Notifications", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/notifications", "host": ["{{baseUrl}}"], "path": ["audience","notifications"] } } },
        { "name": "Mark All Notifications Read", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/notifications/mark-read", "host": ["{{baseUrl}}"], "path": ["audience","notifications","mark-read"] } } },
        { "name": "Delete Notification", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }], "url": { "raw": "{{baseUrl}}/audience/notifications/1", "host": ["{{baseUrl}}"], "path": ["audience","notifications","1"] } } }
      ]
    },
    {
      "name": "Support & Funding",
      "item": [
        { "name": "Send Support Message", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"name\": \"Tester\", \"email\": \"tester@example.com\", \"subject\": \"Help\", \"message\": \"Please assist\" }" , }, "url": { "raw": "{{baseUrl}}/audience/contact", "host": ["{{baseUrl}}"], "path": ["audience","contact"] } } },
        { "name": "Get Funding Rounds", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/audience/startups/{{startupId}}/funding-rounds", "host": ["{{baseUrl}}"], "path": ["audience","startups","{{startupId}}","funding-rounds"] } } }
      ]
    }
  ]
}
